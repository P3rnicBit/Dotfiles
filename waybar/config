[
    {
        "layer": "top",
        "position": "top",
        "height": 30,
        "spacing": 4,
        "margin-top": 0,
        "margin-bottom": 0,
        "margin-left": 0,
        "margin-right": 0,
        "output": "HDMI-A-1",
        "name": "HDMI-bar",
        "modules-left": [
            "cpu",
            "temperature",
            "memory",
            "custom/gpu",
            "custom/power",
            "custom/disk",
            "network"
        ],
        "modules-right": [
            "pulseaudio",
            "mpd"
        ],



        "mpris": {
            "format": " {player_icon} {dynamic}",
            "format-paused": "{status_icon} <i>{dynamic}</i>",
            "format-playing": "{status_icon} {dynamic}",
            "interval": 1,
            "player-icons": {
                "default": "▶",
                "mpv": "🎵"
            },
            "status-icons": {
                "paused": "⏸",
                "playing": "▶ "
            },
            "tooltip": false
        },
        "mpd": {
            "format": "{stateIcon} {artist} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S})",
            "format-disconnected": "Disconnected ",
            "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
            "unknown-tag": "N/A",
            "interval": 1,
            "consume-icons": {
                "on": " "
            },
            "random-icons": {
                "off": "<span color=\"#f53c3c\"></span> ",
                "on": " "
            },
            "repeat-icons": {
                "on": " "
            },
            "single-icons": {
                "on": "1 "
            },
            "state-icons": {
                "paused": "",
                "playing": ""
            }
        },
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
                "activated": "",
                "deactivated": ""
            }
        },
        "cpu": {
            "format": "{usage}% ",
            "tooltip": false
        },
        "temperature": {
            "thermal-zone": 2,
            "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
            "critical-threshold": 80,
            "format": "{temperatureC}°C {icon}",
            "format-icons": [
                "",
                "",
                ""
            ],
            "interval": 1,
            "tooltip": false
        },
        "memory": {
            "format": "{}% ",
            "interval": 1
        },
        "network": {
            "format-wifi": "{essid} ({signalStrength}%) ",
            "format-ethernet": "{ipaddr}/{cidr} ",
            "tooltip-format": "{ifname} via {gwaddr} ",
            "format-linked": "{ifname} (No IP) ",
            "format-disconnected": "Disconnected ⚠",
            "format-alt": "{ifname}: {ipaddr}/{cidr}",
            "tooltip": false
        },
        "custom/gpu": {
            "exec": "/home/LukPer/.config/scripts/gpuStatus",
            "interval": 1,
            "format": "{} 󰢮",
            "tooltip": false,
            "on-click": "/home/LukPer/.config/scripts/gpuStatus"
        },
        "custom/power": {
            "exec": "/home/LukPer/.config/scripts/powerDraw",
            "interval": 1,
            "format": "{}",
            "tooltip": false,
            "on-click": "/home/LukPer/.config/scripts/powerDraw"
        },
        "pulseaudio": {
            "format": "{volume}% {icon}    |   {format_source}",
            "format-bluetooth": "{volume}% {icon} {format_source}",
            "format-bluetooth-muted": " {icon} {format_source}",
            "format-muted": " {format_source}",
            "format-source": "{volume}% ",
            "format-source-muted": "",
            "format-icons": {
                "headphone": "",
                "hands-free": "",
                "headset": "",
                "phone": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    "",
                    ""
                ]
            },
            "on-click": "com.github.wwmm.easyeffects",
            "tooltip": false
        },
                "custom/disk": {
            "exec": "/home/LukPer/.config/scripts/storage",
            "interval": 10,
            "format": "{}",
            "on-click": "/home/LukPer/.config/scripts/storage",
            "tooltip": false
        }
    },















    {
        "layer": "top",
        "position": "top",
        "height": 30,
        "spacing": 4,
        "margin-top": 0,
        "margin-bottom": 0,
        "margin-left": 0,
        "margin-right": 0,
        "output": "DP-2",
        "name": "DP-bar",
        "modules-left": [
            "custom/VPNstatus",
            "custom/update"
        ],
        "modules-center": [
            "hyprland/workspaces"
        ],
        "modules-right": [
            "hyprland/language",
            "clock"
        ],
        "hyprland/workspaces": {
            "persistent-workspaces": {
                "1": [],
                "2": [],
                "3": [],
                "4": [],
                "5": [],
                "6": []
            },
            "disable-scroll": true,
            "all-outputs": true,
            "warp-on-scroll": false,
            "format": "{icon}",
            "format-icons": {
                "1": "〡",
                "2": "〢",
                "3": "〣",
                "4": "イ",
                "5": "〤",
                "6": "サ",
                "7": "セ",
                "8": "〥",
                "9": "キ",
                "10": "〩"
            }
        },
        "clock": {
            "format": "{:%a | %d. %B | %H:%M} ",
            "tooltip": false,
            "interval": 15
        },
        "custom/VPNstatus": {
            "exec": "/home/LukPer/.config/scripts/CheckVPNStatus.sh",
            "interval": 1,
            "format": "{}",
            "on-click": "/home/LukPer/.config/scripts/VPNConnect.sh",
            "tooltip": false
        },
        "custom/update": {
            "format": "UPDATE SYSTEM",
            "on-click": "/home/LukPer/.config/scripts/update"
        },
                "hyprland/language": {
            "format": "{} ",
            "format-us": "US ",
            "format-cz": " CZ"
        }
    }
]
