# --- Connection ---
mpd_host = "127.0.0.1"
mpd_port = "6600"
ncmpcpp_directory = "~/.config/ncmpcpp"

visualizer_data_source = "/tmp/mpd.fifo"
visualizer_output_name = "my_fifo"
visualizer_in_stereo = "yes"
visualizer_type = "wave_filled"
visualizer_look = "〤|"
# For ellipse visualizer_type
#visualizer_color = "211,209,207,205,203,201,199,197,250"
#For wave_filled
visualizer_color = "250,197,199,201,203,205,207,209,211" 

# --- UI Settings ---
user_interface = "alternative"
header_visibility = "yes"
statusbar_visibility = "yes"
titles_visibility = "no"
autocenter_mode = "yes"
centered_cursor = "yes"
playlist_show_mpd_host = "no"
playlist_show_remaining_time = "no"
media_library_primary_tag = "artist"
follow_now_playing_lyrics = "yes"
fetch_lyrics_for_current_song_in_background = "yes"
clock_display_seconds = "no"

# --- Progress Bar ---
progressbar_look = "━━━"
progressbar_color = "211"
progressbar_elapsed_color = "197:b"

# --- Colors & Highlights ---
colors_enabled = "yes"

# Main text colors
main_window_color = "204"          

header_window_color = "201"       
statusbar_color = "206"
statusbar_time_color = "201:b"
volume_color = "201"
state_line_color = "198"
alternative_ui_separator_color = "211"
window_border_color = "200"

current_item_prefix = $i$b$r
current_item_suffix = $/i$/b$/r$(end)

# Status and Alerts
empty_tag_color = "200"          
state_flags_color = "203"


# --- Song List Format ---
song_list_format = {$b$(133)%a$/b}{$(255) | }{$(202)%t}$R{$(198)%l}
song_status_format = {{%a{ "%b"{ (%y)}} - }{%t}}|{%f}

alternative_header_first_line_format = $b$(206)$aqqu$/a$9 {%t}|{%f} $(206)$atqq$/a$9$b
alternative_header_second_line_format = {$(255) <━━━━━━━━━━━|}  {$(203)$b%a$/b$9} {{$(255)——} $(205)%b$9}  {$(255)|━━━━━━━━━━━>}

playlist_editor_column_width_ratio = 1:1

song_columns_list_format = (40)[206]{a} (25)[205]{b} (35)[204]{t|f:Title} %R(4f)[197]{l}
